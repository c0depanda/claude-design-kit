# Settings for the kit's tools, shown for the invented example product Halcyon. Copy this file to env.local (git
# ignores it), set the three paths below, and load it with
#   set -a; source <kit>/tools/env.local; set +a
# Enable optional settings only when needed. No Claude API key is required.
# Keep app credentials and Playwright storage states outside version control.

# This kit's folder (WORKFLOW.md writes commands as $KIT/tools/…).
KIT="/path/to/claude-design-kit"

# The Claude Design export the tools read: a folder of *.dc.html files. Default: ./Design under the current folder.
DESIGN_DIR="/path/to/halcyon/Design"

# Where install-export.py keeps the previous export. Default: a design-backups folder beside DESIGN_DIR.
DESIGN_BACKUPS="/path/to/halcyon/work/design-backups"

# Playwright for shoot.mjs, compare-render.mjs and the contract checker: playwright's index.js inside a project that
# has it. Leave it unset to resolve Playwright from the current folder, or from tools/ after `npm ci` there.
# PLAYWRIGHT_MODULE="/path/to/halcyon/app/node_modules/playwright/index.js"

# Contract checker (tools/contract/check.mjs). Required:
APP_URL="http://localhost:3000"                 # the running app
REFERENCE_PREFIXES="HX"                         # prefixes of record references such as HX-PAY-1042 ("" if none)
# Required only when a mapped frame has a scenario and AUTH_MODULE has no applyScenario():
# SCENARIO_ENDPOINT="/api/review/scenario"      # receives POST { "scenarioId": "…" }
# SCENARIO_HEADERS='{"x-hx-request":"1"}'       # extra headers for that request ('{}' for none)
# Optional:
# AUTH_MODULE="/path/to/halcyon/work/review-auth.mjs" # exports openSession() and optionally applyScenario()
STORAGE_STATE_DIR=""                            # or Playwright storage states named <account>.json
SHELL_LABELS="Home,Payments,Accounts,Settings"  # the app shell's navigation labels (default none)
PHONE_HEADER_HEIGHT="56"                        # the phone header's height in px (default 0)
COMPONENT_PREFIX="hx"                           # class prefix of the design system's parts (default hx)
PART_PREFIXES="hx"                              # every class prefix that counts as a part (default the one above)
UTILITY_PATTERN=""                              # regex for prefixed classes that aren't parts (default none)
THEME_ATTRIBUTE="data-theme=light"              # set on <html> before measuring (default data-theme=light)
HIDE_SELECTORS=""                               # dev tools floating over the app (default none)
LOCALE="en-GB"
